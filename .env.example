# Скопируйте этот файл в .env и укажите свой ключ. Файл .env в git не попадает.

# --- Облако: OpenRouter (по умолчанию) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
# Любая модель OpenRouter с поддержкой structured outputs
# (фильтр supported_parameters=structured_outputs на openrouter.ai/models)
LLM_MODEL=openai/gpt-4o-mini

# --- Замкнутый контур: локальная модель (раскомментируйте один из вариантов) ---
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:14b-instruct
# vLLM:       LLM_BASE_URL=http://localhost:8000/v1    LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
# llama.cpp:  LLM_BASE_URL=http://localhost:8080/v1    LLM_MODEL=local
# Для локальных серверов ключ не нужен: LLM_API_KEY можно оставить пустым.

# --- Тонкая настройка (необязательно) ---
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=90
# auto | json_schema | json_object | prompt — как просить у модели JSON
LLM_RESPONSE_FORMAT=auto
# Сколько раз просить модель исправить ответ, если проверка нашла проблемы
MAX_REPAIR_ATTEMPTS=1

# --- Смысловая проверка (модель-судья) ---
# Второй запрос к модели сверяет утверждения текста с входными данными
# (перенос свойства части на весь прибор, оценки и сферы применения не из данных).
# on | off. Примерно удваивает число запросов к модели.
JUDGE=on
# Модель для проверки; пусто — та же, что LLM_MODEL. Можно взять модель сильнее.
JUDGE_MODEL=
